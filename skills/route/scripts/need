#!/usr/bin/env python3
"""need — route's need for doctor (one JSON line): routes the user approved in
the sweep that nobody has built yet (status approved or handed in the sweep's
decisions log). Those are the user's decisions; route builds them, a service's
own Urgent rule included. Only generic Urgent keys (svc '*') are lane-urgent's."""
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "lib"))
import svetovid as sv  # noqa: E402

try:
    pats = json.loads((sv.home() / "sweep" / "known.json").read_text(encoding="utf-8"))["patterns"]
except FileNotFoundError:
    pats = []
open_ = [p for p in pats if p.get("status") in ("approved", "handed") and p.get("svc") != "*"]
by_svc = {}
for p in open_:
    by_svc.setdefault(p["svc"], []).append(p)
work = [f"{svc}: {len(ps)} approved route(s) not built ({', '.join(p['id'] + ' ' + p.get('kind', '')[:40] for p in ps)})"
        for svc, ps in sorted(by_svc.items())]
# No routine check-up: route only ever runs for a concrete service.
sv.need_report("route", work, 0)
